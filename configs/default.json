{
    "app_name": "SMART-IDS",
    "log_text_file": "ids_log.txt",
    "log_json_file": "ids_log.jsonl",
    "ui_refresh_ms": 250,

    "detection": {
        "port_scan_unique_ports": 8,
        "port_scan_window_sec": 8,
        "icmp_burst_threshold": 10,
        "icmp_burst_window_sec": 5,
        "tcp_burst_threshold": 20,
        "tcp_burst_window_sec": 5,
        "alert_cooldown_sec": 5
    },

    "defaults": {
        "defender_interface": "lo",
        "attacker_target": "127.0.0.1",
        "port_scan_start": 20,
        "port_scan_end": 60,
        "tcp_port": 8000,
        "tcp_connections": 50,
        "ping_count": 25
    }
}